{$DOMAIN} {
	handle /.well-known/matrix/server {
		header Content-Type application/json
		respond `{"m.server":"{$DOMAIN}:443"}` 200
	}

	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.homeserver":{"base_url":"https://{$DOMAIN}"}}` 200
	}

	handle /_dirextalk/updater/v1/jobs/* {
		reverse_proxy unix//run/dirextalk-updater/http.sock
	}

	handle /agent/v1/* {
		reverse_proxy agent:8082 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy message-server:8008
	}
}
